# Copy to .env for local dev.  Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,.myapp.ng

# Leave DATABASE_URL unset for local development: the default is a SQLite file
# at ./schapp.sqlite3, with one ./.tenant-databases/<school>.sqlite3 per school.
# Production is MySQL and refuses to start on anything else:
#   DATABASE_URL=mysql://schapp:schapp@localhost:3306/schapp
# The account in that URL needs CREATE/DROP DATABASE — tenants are provisioned
# at runtime, each into its own `schapp_<school>` database.
# DATABASE_URL=

# Leave these unset for a server-free local run: config.settings.dev then uses
# an in-process cache and runs Celery tasks inline. Uncomment to use real Redis.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Fernet key for per-tenant secrets (payment gateway keys, SMS creds, NIN).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=E1jMh9m6uW1x2FvR3kZq7pT8sYbN0cJdA5gLhQwXeUo=

# Wildcard base domain used when provisioning <slug>.<BASE_DOMAIN>
BASE_DOMAIN=localhost

# How many proxies of yours terminate the connection in front of Django (an
# nginx in front of gunicorn is 1; nginx behind Cloudflare is 2). The audit
# trail and the per-IP OTP limit read the X-Forwarded-For entry that many
# places from the right. Leave it at 0 unless you actually run one: trusting a
# header nobody strips lets a caller choose their own address.
TRUSTED_PROXY_DEPTH=0

# Days a school keeps working after its trial ends (status PAST_DUE, still
# servable) before tenants.expire_trials suspends it.
TENANT_PAST_DUE_GRACE_DAYS=14

# Origin printed into the verification QR on transcripts and ID cards. It is
# baked into paper that outlives the deployment, so change it only if that
# address really has moved — every document already printed points at the old
# one. Defaults to https://<BASE_DOMAIN>.
# DOCUMENT_VERIFY_BASE_URL=https://schapp.ng

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
SENTRY_DSN=

EMAIL_HOST=localhost
EMAIL_PORT=1025

# Phase 2+
SMS_BACKEND=apps.communication.sms.console.ConsoleBackend

# Phase 5: payment gateway keys are per school, not per deployment — set them
# on the tenant's TenantConfiguration (admin → Tenant configuration), where
# they are Fernet-encrypted. Register the webhook URL with the gateway as:
#   https://<host>/api/v1/public/finance/webhook/paystack/<school-slug>/
#   https://<host>/api/v1/public/finance/webhook/flutterwave/<school-slug>/
# For Flutterwave the "secret key" field holds the shared verif-hash.
